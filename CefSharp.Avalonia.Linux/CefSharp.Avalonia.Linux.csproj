<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>

    <!-- Content-only package: ships the Linux (x64) native binaries for
         CefSharp.Avalonia. Kept separate from the main package because a single
         CEF distribution is ~150-180 MB, and bundling both Windows + Linux in
         one nupkg exceeds NuGet.org's 250 MB limit. -->
    <PackageId>CefSharp.Avalonia.Linux</PackageId>
    <Version>1.2.0</Version>
    <Authors>CefBrowser</Authors>
    <Description>Linux (x64) native binaries (CEF runtime + CefBrowser.Native host) for CefSharp.Avalonia.</Description>
    <PackageTags>avalonia;cef;chromium;browser;linux</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EgorVictor/CefAvalonia</PackageProjectUrl>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>NU5128</NoWarn>

    <!-- Default to the local native build dir; CI overrides with the downloaded
         Linux native artifact (-p:CefNativeLinuxDir=...). -->
    <CefNativeLinuxDir Condition="'$(CefNativeLinuxDir)' == ''">..\CefBrowser.Native\build\Release</CefNativeLinuxDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="build\*" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!--
    WHITELIST, not a recursive glob: the native build output dir also carries
    build artifacts (libcef_dll_wrapper static lib, object files, CMake files),
    and excluding them by extension was not enough — the package still came out
    at ~318 MB and NuGet.org rejected it with HTTP 413 (>250 MB limit).

    libcef.so is deliberately NOT shipped: it is ~1.05 GB raw / ~240 MB
    compressed, so no package containing it can ever fit under NuGet.org's
    250 MB hard limit. Everything else here is ~93 MB raw (~40-50 MB packed).

    Consumers must supply libcef.so themselves, either by pointing CEF_ROOT
    (or CEFAVALONIA_CEF_ROOT) at a CEF 109 Linux64 distribution, or by letting
    the control download and cache it on first run (see CefRuntimeResolver).
  -->
   <!-- Gate on the host executable, NOT libcef.so: libcef.so is no longer part
       of this package, so gating on it would silently emit an EMPTY package
       whenever the native build dir lacks it. -->
  <ItemGroup Condition="Exists('$(CefNativeLinuxDir)\CefBrowser.Native')">
    <!-- Host executable + sandbox helper -->
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\CefBrowser.Native" />
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\chrome-sandbox" />

    <!-- CEF shared libraries (libcef.so excluded — see note above) -->
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\libEGL.so" />
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\libGLESv2.so" />
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\libvk_swiftshader.so" />
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\libvulkan.so.1" />
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\vk_swiftshader_icd.json" />

    <!-- Resources: ICU data, V8 snapshots, .pak bundles + localized strings -->
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\*.dat" />
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\*.bin" />
    <CefLinuxNativeFile Include="$(CefNativeLinuxDir)\*.pak" />

    <Content Include="@(CefLinuxNativeFile)"
             Pack="true" PackagePath="runtimes\linux-x64\native\">
      <Visible>false</Visible>
    </Content>

    <!-- Localized strings keep their own subfolder. PackagePath ends with a
         separator so NuGet appends each file name itself: %(RecursiveDir) is
         only populated for '**' globs, which silently flattened locales/. -->
    <Content Include="$(CefNativeLinuxDir)\locales\*.pak"
             Pack="true" PackagePath="runtimes\linux-x64\native\locales\">
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
