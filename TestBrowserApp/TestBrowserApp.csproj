<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Must match CefSharp.Avalonia target framework -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="publish\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Must use same Avalonia version as CefSharp.Avalonia -->
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.7">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReactiveUI" Version="20.1.63" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CefSharp.Avalonia\CefSharp.Avalonia.csproj" />
  </ItemGroup>

  <!-- Copy CEF native files from C++ build output -->
  <Target Name="CopyCefNativeFiles" AfterTargets="Build">
    <PropertyGroup>
      <_CefNativeSource>..\CefBrowser.Native\build\Release\</_CefNativeSource>
    </PropertyGroup>
    <ItemGroup>
      <CefNativeFiles Include="$(_CefNativeSource)CefBrowser.Native.exe" />
      <CefNativeFiles Include="$(_CefNativeSource)libcef.dll" />
      <CefNativeFiles Include="$(_CefNativeSource)chrome_elf.dll" />
      <CefNativeFiles Include="$(_CefNativeSource)d3dcompiler_47.dll" />
      <CefNativeFiles Include="$(_CefNativeSource)icudtl.dat" />
      <CefNativeFiles Include="$(_CefNativeSource)libEGL.dll" />
      <CefNativeFiles Include="$(_CefNativeSource)libGLESv2.dll" />
      <CefNativeFiles Include="$(_CefNativeSource)resources.pak" />
      <CefNativeFiles Include="$(_CefNativeSource)chrome_100_percent.pak" />
      <CefNativeFiles Include="$(_CefNativeSource)chrome_200_percent.pak" />
      <CefNativeFiles Include="$(_CefNativeSource)snapshot_blob.bin" />
      <CefNativeFiles Include="$(_CefNativeSource)v8_context_snapshot.bin" />
      <CefNativeFiles Include="$(_CefNativeSource)vk_swiftshader.dll" />
      <CefNativeFiles Include="$(_CefNativeSource)vk_swiftshader_icd.json" />
      <CefNativeFiles Include="$(_CefNativeSource)vulkan-1.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <!-- Copy locales -->
    <ItemGroup>
      <CefLocales Include="$(_CefNativeSource)locales\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CefLocales)" DestinationFolder="$(OutputPath)\locales\" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(CefNativeFiles)">
        <RelativePath>%(CefNativeFiles.Filename)%(CefNativeFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
