<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Must match CefSharp.Avalonia target framework -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="publish\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Must use same Avalonia version as CefSharp.Avalonia -->
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.7">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReactiveUI" Version="20.1.63" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CefSharp.Avalonia\CefSharp.Avalonia.csproj" />
    <!-- CEF 运行时二进制与语言资源来自 NuGet，新机器 restore 后即可编译 -->
    <PackageReference Include="ChromiumEmbeddedFramework.runtime" Version="109.1.11" />
    <PackageReference Include="ChromiumEmbeddedFramework.runtime.win-x64" Version="109.1.11" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Copy CEF native files: 原生子进程 exe 用 git 内的 prebuilt（或本机重新构建的新产物），其余 CEF 二进制来自 NuGet -->
  <Target Name="CopyCefNativeFiles" AfterTargets="Build">
    <PropertyGroup>
      <_NativeExeSource Condition="Exists('..\CefBrowser.Native\build\Release\CefBrowser.Native.exe')">..\CefBrowser.Native\build\Release\CefBrowser.Native.exe</_NativeExeSource>
      <_NativeExeSource Condition="'$(_NativeExeSource)' == ''">..\CefBrowser.Native\prebuilt\CefBrowser.Native.exe</_NativeExeSource>
      <_CefNativeDir>$(Pkgchromiumembeddedframework_runtime_win-x64)\runtimes\win-x64\native\</_CefNativeDir>
    </PropertyGroup>
    <ItemGroup>
      <CefNativeFiles Include="$(_CefNativeDir)*" />
      <_NativeExe Include="$(_NativeExeSource)" />
      <CefLocales Include="@(CefRuntimeWin64Locales)" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeExe)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefLocales)" DestinationFolder="$(OutputPath)\locales\" SkipUnchangedFiles="true" />
    <Message Text="CEF native files copied from NuGet + $(_NativeExeSource)" Importance="high" />
  </Target>
</Project>
