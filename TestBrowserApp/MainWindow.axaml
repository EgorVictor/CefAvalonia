<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cc="clr-namespace:CefSharp.Avalonia;assembly=CefSharp.Avalonia"
        mc:Ignorable="d"
        x:Class="TestBrowserApp.MainWindow"
        Width="1280" Height="800"
        Background="#F5F6F7"
        Title="Modern Browser">

  <Window.Resources>
    <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#1E4FCF"/>
    <SolidColorBrush x:Key="PrimaryActive" Color="#1A3FA8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
  </Window.Resources>

  <!-- ===================== 全局样式 ===================== -->
  <Window.Styles>

    <!-- 按钮 -->
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#F0F0F0"/>
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#E5E5E5"/>
    </Style>

    <!-- 主按钮 -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Primary}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
    </Style>

    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{StaticResource PrimaryActive}"/>
    </Style>

    <!-- 图标按钮 -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#444"/>
    </Style>

    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="#EAEAEA"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- 输入框 -->
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- TabControl -->
    <Style Selector="TabControl">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- TabItem -->
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{StaticResource Primary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

  </Window.Styles>

  <!-- ===================== 布局 ===================== -->
  <Grid RowDefinitions="56,48,*,28">

    <!-- 顶部标题栏 -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
        <TextBlock Text="Modern Browser"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#111827"/>

        <Button x:Name="NewTabButton"
                Grid.Column="2"
                Content="+ New Tab"
                Classes="primary"
                Height="32"
                Padding="12,4"
                Margin="8,0,0,0"/>
      </Grid>
    </Border>

    <!-- 地址栏 -->
    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
      <DockPanel VerticalAlignment="Center" Margin="12,0">

        <Button x:Name="RefreshButton"
                Classes="icon"
                Content="⟳"
                DockPanel.Dock="Left"
                Margin="0,0,8,0"/>

        <Button x:Name="GoButton"
                Classes="primary"
                Content="Go"
                Width="60"
                Height="32"
                DockPanel.Dock="Right"
                Margin="8,0,0,0"/>

        <TextBox x:Name="AddressBar"
                 Watermark="Enter URL"
                 Height="34"/>
      </DockPanel>
    </Border>

    <!-- 浏览器 Tab 区域 -->
    <TabControl Grid.Row="2" x:Name="BrowserTabs"/>

    <!-- 状态栏 -->
    <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusBar"
                 Text="Ready"
                 VerticalAlignment="Center"
                 Margin="12,0"
                 FontSize="12"
                 Foreground="#6B7280"/>
    </Border>

  </Grid>
</Window>
