<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cc="clr-namespace:CefSharp.Avalonia;assembly=CefSharp.Avalonia"
        mc:Ignorable="d"
        x:Class="TestBrowserApp.MainWindow"
        Width="1280" Height="800"
        Background="#F5F6F7"
        Title="Modern Browser">

  <Window.Resources>
    <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#1E4FCF"/>
    <SolidColorBrush x:Key="PrimaryActive" Color="#1A3FA8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
  </Window.Resources>

  <!-- ===================== 全局样式 ===================== -->
  <Window.Styles>

    <!-- 按钮 -->
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#F0F0F0"/>
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#E5E5E5"/>
    </Style>

    <!-- 主按钮 -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Primary}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
    </Style>

    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{StaticResource PrimaryActive}"/>
    </Style>

    <!-- 图标按钮 -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#444"/>
    </Style>

    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="#EAEAEA"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- 输入框 -->
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- TabControl -->
    <Style Selector="TabControl">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- TabItem -->
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{StaticResource Primary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

  </Window.Styles>

  <!-- ===================== 布局 ===================== -->
  <Grid RowDefinitions="56,48,*,28">

    <!-- 顶部标题栏 -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
        <TextBlock Text="Modern Browser"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#111827"/>

        <Button x:Name="NewTabButton"
                Grid.Column="2"
                Content="+ New Tab"
                Classes="primary"
                Height="32"
                Padding="12,4"
                Margin="8,0,0,0"/>
      </Grid>
    </Border>

    <!-- 地址栏 + 查找条 -->
    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
      <Grid RowDefinitions="Auto,Auto">

        <!-- 地址栏行 -->
        <DockPanel Grid.Row="0" VerticalAlignment="Center" Margin="12,6">
          <Button x:Name="BackButton"
                  Classes="icon"
                  Content="←"
                  ToolTip.Tip="Back"
                  DockPanel.Dock="Left"
                  Margin="0,0,4,0"/>

          <Button x:Name="ForwardButton"
                  Classes="icon"
                  Content="→"
                  ToolTip.Tip="Forward"
                  DockPanel.Dock="Left"
                  Margin="0,0,4,0"/>

          <Button x:Name="RefreshButton"
                  Classes="icon"
                  Content="⟳"
                  ToolTip.Tip="Reload"
                  DockPanel.Dock="Left"
                  Margin="0,0,4,0"/>

          <Button x:Name="StopButton"
                  Classes="icon"
                  Content="⏹"
                  ToolTip.Tip="Stop loading"
                  DockPanel.Dock="Left"
                  Margin="0,0,8,0"/>

          <Button x:Name="DevToolsButton"
                  Classes="icon"
                  Content="⚙"
                  ToolTip.Tip="DevTools"
                  DockPanel.Dock="Left"
                  Margin="0,0,8,0"/>

          <Button x:Name="ZoomOutButton"
                  Classes="icon"
                  Content="−"
                  ToolTip.Tip="Zoom out"
                  DockPanel.Dock="Right"
                  Margin="0,0,2,0"/>

          <Button x:Name="ZoomResetButton"
                  Content="100%"
                  Height="32"
                  FontSize="12"
                  Padding="8,0"
                  DockPanel.Dock="Right"
                  Margin="0,0,2,0"/>

          <Button x:Name="ZoomInButton"
                  Classes="icon"
                  Content="+"
                  ToolTip.Tip="Zoom in"
                  DockPanel.Dock="Right"
                  Margin="0,0,2,0"/>

          <Button x:Name="FindButton"
                  Classes="icon"
                  Content="🔍"
                  ToolTip.Tip="Find on page"
                  DockPanel.Dock="Right"
                  Margin="0,0,8,0"/>

          <Button x:Name="GoButton"
                  Classes="primary"
                  Content="Go"
                  Width="60"
                  Height="32"
                  DockPanel.Dock="Right"
                  Margin="8,0,0,0"/>

          <TextBox x:Name="AddressBar"
                   Watermark="Enter URL"
                   Height="34"/>
        </DockPanel>

        <!-- 查找条（默认隐藏） -->
        <DockPanel x:Name="FindBar"
                   Grid.Row="1"
                   IsVisible="False"
                   VerticalAlignment="Center"
                   Margin="12,4,12,8">
          <Button x:Name="FindCloseButton"
                  Classes="icon"
                  Content="✕"
                  ToolTip.Tip="Close find"
                  DockPanel.Dock="Right"
                  Margin="4,0,0,0"/>
          <Button x:Name="FindPrevButton"
                  Classes="icon"
                  Content="↑"
                  ToolTip.Tip="Previous match"
                  DockPanel.Dock="Right"
                  Margin="4,0,0,0"/>
          <Button x:Name="FindNextButton"
                  Classes="icon"
                  Content="↓"
                  ToolTip.Tip="Next match"
                  DockPanel.Dock="Right"
                  Margin="4,0,0,0"/>
          <TextBlock Text="查找:"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"
                     FontSize="13"
                     Foreground="#6B7280"/>
          <TextBox x:Name="FindTextBox"
                   Watermark="输入要查找的文字…"
                   Height="30"/>
        </DockPanel>
      </Grid>
    </Border>

    <!-- 浏览器 Tab 区域 -->
    <TabControl Grid.Row="2" x:Name="BrowserTabs"/>

    <!-- 状态栏 + 下载进度 -->
    <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0" VerticalAlignment="Center">
        <ProgressBar x:Name="DownloadProgressBar"
                     DockPanel.Dock="Right"
                     Width="160"
                     Height="10"
                     Minimum="0"
                     Maximum="100"
                     IsVisible="False"
                     Margin="12,0,0,0"/>
        <TextBlock x:Name="StatusBar"
                   Text="Ready"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="#6B7280"/>
      </DockPanel>
    </Border>

  </Grid>
</Window>
