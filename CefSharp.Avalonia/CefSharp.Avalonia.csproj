<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>CefSharp.Avalonia</PackageId>
    <Version>1.1.0</Version>
    <Authors>CefBrowser</Authors>
    <Description>Avalonia CefBrowser wrapper control. Embeds a CEF (Chromium Embedded Framework) browser as an Avalonia control using a native child process and stdio IPC on Windows and Linux.</Description>
    <PackageTags>avalonia;cef;chromium;browser;webview</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EgorVictor/CefAvalonia</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>NU5100</NoWarn>
  </PropertyGroup>

  <!-- The library only needs the core Avalonia package: NativeControlHost and
       the control primitives live in 'Avalonia', not 'Avalonia.Desktop'. Forcing
       Avalonia.Desktop here would impose a platform backend on every consumer,
       so the demo app references Avalonia.Desktop itself. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
  </ItemGroup>

  <!-- Include build targets in the NuGet package -->
  <ItemGroup>
    <Content Include="build\*" Pack="true" PackagePath="build\" />
    <Content Include="buildTransitive\*" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Native binaries ship as RID-specific assets so ONE package serves both
       Windows (win-x64) and Linux (linux-x64). Each block is guarded by the
       platform marker file: a local dev pack only includes the platform that is
       actually present, while CI stages both into dedicated dirs (via
       -p:CefNativeWinDir=... / -p:CefNativeLinuxDir=...) before packing. -->
  <PropertyGroup>
    <CefNativeWinDir Condition="'$(CefNativeWinDir)' == ''">..\CefBrowser.Native\build\Release</CefNativeWinDir>
    <CefNativeLinuxDir Condition="'$(CefNativeLinuxDir)' == ''">..\CefBrowser.Native\build\Release</CefNativeLinuxDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(CefNativeWinDir)\libcef.dll')">
    <Content Include="$(CefNativeWinDir)\*.*"
             Exclude="$(CefNativeWinDir)\*.ilk;$(CefNativeWinDir)\*.obj;$(CefNativeWinDir)\*.pdb;$(CefNativeWinDir)\*.exp;$(CefNativeWinDir)\*.lib"
             Pack="true" PackagePath="runtimes\win-x64\native\%(Filename)%(Extension)">
      <Visible>false</Visible>
    </Content>
    <Content Include="$(CefNativeWinDir)\locales\*.*" Pack="true" PackagePath="runtimes\win-x64\native\locales\%(Filename)%(Extension)">
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(CefNativeLinuxDir)\libcef.so')">
    <Content Include="$(CefNativeLinuxDir)\**\*"
             Exclude="$(CefNativeLinuxDir)\*.obj;$(CefNativeLinuxDir)\*.pdb;$(CefNativeLinuxDir)\*.a;$(CefNativeLinuxDir)\*.dll;$(CefNativeLinuxDir)\*.exe;$(CefNativeLinuxDir)\*.lib;$(CefNativeLinuxDir)\*.exp"
             Pack="true" PackagePath="runtimes\linux-x64\native\%(RecursiveDir)%(Filename)%(Extension)">
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- Windows: copy native binaries next to the managed assembly for local runs. -->
  <Target Name="CopyCefBrowserNativeWindows" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <CefNativeDir>..\CefBrowser.Native\build\Release</CefNativeDir>
    </PropertyGroup>
    <ItemGroup>
      <CefBinFiles Include="$(CefNativeDir)\*.*" Exclude="$(CefNativeDir)\*.obj;$(CefNativeDir)\*.pdb;$(CefNativeDir)\*.ilk;$(CefNativeDir)\*.exp;$(CefNativeDir)\*.lib" />
    </ItemGroup>
    <Copy SourceFiles="@(CefBinFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <CefLocales Include="$(CefNativeDir)\locales\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CefLocales)" DestinationFolder="$(OutputPath)\locales\" SkipUnchangedFiles="true" />
    <Message Text="Copied CefBrowser.Native from Release to $(OutputPath)" Importance="high" />
  </Target>

  <!-- Linux: same, but the executable has no extension and needs +x. -->
  <Target Name="CopyCefBrowserNativeLinux" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <CefNativeDir Condition="Exists('..\CefBrowser.Native\build\Release\libcef.so')">..\CefBrowser.Native\build\Release</CefNativeDir>
      <CefNativeDir Condition="'$(CefNativeDir)' == '' AND Exists('..\CefBrowser.Native\build\libcef.so')">..\CefBrowser.Native\build</CefNativeDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(CefNativeDir)' != ''">
      <CefBinFiles Include="$(CefNativeDir)\**\*" Exclude="$(CefNativeDir)\*.a;$(CefNativeDir)\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(CefBinFiles)"
          DestinationFiles="@(CefBinFiles->'$(OutputPath)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(CefNativeDir)' != ''" />
    <Exec Command="chmod +x &quot;$(OutputPath)CefBrowser.Native&quot;"
          Condition="Exists('$(OutputPath)CefBrowser.Native')" />
    <Exec Command="chmod +x &quot;$(OutputPath)chrome-sandbox&quot;"
          Condition="Exists('$(OutputPath)chrome-sandbox')" />
    <Message Text="Copied CefBrowser.Native from $(CefNativeDir) to $(OutputPath)" Importance="high"
             Condition="'$(CefNativeDir)' != ''" />
  </Target>

  <!-- dotnet publish may copy files again after the Build target, resetting
       Unix mode bits. Re-apply +x on the final publish output. -->
  <Target Name="ChmodCefNativeLinuxPublish" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$(PublishDir)' != ''">
    <Exec Command="chmod +x &quot;$(PublishDir)CefBrowser.Native&quot;"
          Condition="Exists('$(PublishDir)CefBrowser.Native')" />
    <Exec Command="chmod +x &quot;$(PublishDir)chrome-sandbox&quot;"
          Condition="Exists('$(PublishDir)chrome-sandbox')" />
  </Target>
</Project>
