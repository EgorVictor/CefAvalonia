<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>

    <!-- Content-only package: ships the Windows (x64) native CEF binaries for
         CefSharp.Avalonia. Kept separate from the managed-only main package so
         a Linux-only restore does not download the ~116 MB Windows CEF payload.
         Together with CefSharp.Avalonia.Linux this also keeps each package under
         NuGet.org's 250 MB limit. -->
    <PackageId>CefSharp.Avalonia.Windows</PackageId>
    <Version>1.3.0</Version>
    <Authors>CefBrowser</Authors>
    <Description>Windows (x64) native binaries (CEF runtime + CefBrowser.Native host) for CefSharp.Avalonia. Reference this together with CefSharp.Avalonia.</Description>
    <PackageTags>avalonia;cef;chromium;browser;windows</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EgorVictor/CefAvalonia</PackageProjectUrl>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>NU5128</NoWarn>

    <!-- Default to the local native build dir; CI overrides with the downloaded
         Windows native binaries built in the same job. -->
    <CefNativeWinDir Condition="'$(CefNativeWinDir)' == ''">..\CefBrowser.Native\build\Release</CefNativeWinDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="build\*" Pack="true" PackagePath="build\" />
    <Content Include="buildTransitive\*" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Broad glob with the same exclusions the old main package used (build
       artefacts must not leak into the package). libcef.dll gates the item
       group so an empty native dir produces a loudpack failure, not an empty
       package. -->
  <ItemGroup Condition="Exists('$(CefNativeWinDir)\libcef.dll')">
    <Content Include="$(CefNativeWinDir)\*.*"
             Exclude="$(CefNativeWinDir)\*.ilk;$(CefNativeWinDir)\*.obj;$(CefNativeWinDir)\*.pdb;$(CefNativeWinDir)\*.exp;$(CefNativeWinDir)\*.lib"
             Pack="true" PackagePath="runtimes\win-x64\native\%(Filename)%(Extension)">
      <Visible>false</Visible>
    </Content>
    <Content Include="$(CefNativeWinDir)\locales\*.*" Pack="true" PackagePath="runtimes\win-x64\native\locales\%(Filename)%(Extension)">
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
